{
  "name": "curse",
  "version": "0.0.0",
  "description": "A bash-to-TypeScript (.mts) converter — AOT where possible, JIT where not.",
  "license": "GPL-3.0-or-later",
  "type": "module",
  "private": true,
  "bin": {
    "curse": "./src/cli/curse.mts"
  },
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "node --test 'test/**/*.test.mts'",
    "check": "npm run typecheck && npm run test",
    "spec": "node ./test/spec/run.mts",
    "curse": "node ./src/cli/curse.mts"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "typescript": "^7.0.2"
  }
}
