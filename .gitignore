# Local reference checkout of GNU bash (porting source + test suite).
# Not committed: it's upstream GPLv3 source we derive from, kept locally.
# Specific files we port/vendor are attributed in NOTICE.md.
/reference/

# Meson build dir + fetched subprojects (packagefiles/ + *.wrap stay tracked).
/build/
/subprojects/*/
!/subprojects/packagefiles/

# Build / scratch output
/dist/
/.curse-out/
core
core.*
*.core

# BFG Repo-Cleaner report
/..bfg-report/
.ccache/
/test/real/fetched/

# LuaJIT build output (patched luajit + the shippable static `curse` binary)
/.bench-lua/
