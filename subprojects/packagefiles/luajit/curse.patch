   lj_vmevent_send(J2G(J), TRACE,
@@ -883,9 +889,66 @@ static TraceNo trace_exit_find(jit_State *J, MCode *pc)
 #endif
 
 /* A trace exited. Restore interpreter state. */
+#ifdef CURSE_SIG_DESTRUCTIVE
+#include <sys/mman.h>
+#include <unistd.h>
+extern lua_State *curse_globalL(void);
+static MCode *curse_patched_back;   /* Addr of the overwritten back-edge (or NULL). */
+static MCode curse_patched_orig[5]; /* Its original 5 bytes, to restore on exit. */
+
+/* curse: called from the async signal handler when a signal arrives while a JIT
+ * trace is running (LuaJIT hooks don't fire inside a trace). No NOP, no reserved
+ * slot: it destructively repoints the running loop's back-edge jump — an existing,
+ * necessary instruction — from the loop top at the loop's exit stub, so the next
+ * back-edge is a clean, state-restoring side-exit to the interpreter (where the
+ * scheduled VM hook then runs the trap). Only the 4-byte rel32 displacement is
+ * touched; a signal's saved RIP is always an instruction boundary and never lands
+ * inside that operand, so there is no mid-instruction resume hazard, and the
+ * machine state at the back-edge IS the loop snapshot, so exiting there is exact.
+ * lj_trace_exit restores the original target the instant the exit fires. */
+void curse_sig_patch_trace(void)
+{
+  lua_State *L = curse_globalL();
+  global_State *g;
+  jit_State *J;
+  GCtrace *T;
+  MCode *bk, *ex;
+  int32_t vs;
+  intptr_t pg, a, b;
+  if (!L) return;
+  g = G(L);
+  vs = (int32_t)g->vmstate;
+  if (vs <= 0) return;               /* Not currently executing a trace. */
+  J = G2J(g);
+  T = traceref(J, (TraceNo)vs);
+  if (!T || !T->loopback) return;    /* No patchable loop back-edge. */
+  bk = T->loopback; ex = T->loopexit;
+  if (curse_patched_back == bk) return;  /* Already armed on this loop. */
+  if (curse_patched_back) {  /* A stale patch (its trace never ran again): undo it. */
+    memcpy(curse_patched_back, curse_patched_orig, 5);
+    curse_patched_back = NULL;
+  }
+  pg = (intptr_t)sysconf(_SC_PAGESIZE);
+  a = ((intptr_t)bk) & ~(pg-1);
+  b = (((intptr_t)bk + 5 + pg-1) & ~(pg-1));
+  if (mprotect((void *)a, (size_t)(b-a), PROT_READ|PROT_WRITE|PROT_EXEC)) return;
+  memcpy(curse_patched_orig, bk, 5);               /* Save the 5 bytes we clobber. */
+  curse_patched_back = bk;
+  bk[0] = 0xe9;                                     /* jmp rel32 -> loop exit stub. */
+  *(int32_t *)(bk+1) = (int32_t)(ex - (bk+5));
+  /* x86: sigreturn (iret) serializes, so the trace re-fetches the patched rel32. */
+}
+#endif
+
 int LJ_FASTCALL lj_trace_exit(jit_State *J, void *exptr)
 {
   ERRNO_SAVE
+#ifdef CURSE_SIG_DESTRUCTIVE
+  if (curse_patched_back) {  /* Restore the back-edge the instant we exit. */
+    memcpy(curse_patched_back, curse_patched_orig, 5);
+    curse_patched_back = NULL;
+  }
+#endif
   lua_State *L = J->L;
   ExitState *ex = (ExitState *)exptr;
   ExitDataCP exd;
