 /* A trace exited. Restore interpreter state. */
+#ifdef CURSE_SIG_DESTRUCTIVE
+#include <sys/mman.h>
+#include <signal.h>
+#include <unistd.h>
+extern lua_State *curse_globalL(void);
+
+/* curse: asynchronous preemption of running machine code.
+ *
+ * Called from the async signal handler when a signal arrives while a JIT trace
+ * runs (LuaJIT hooks don't fire inside a trace). No per-iteration check: it
+ * rewrites one 5-byte instruction per trace (T->loopback) into a jmp that returns
+ * the running code to the interpreter (where the scheduled VM hook runs the trap):
+ *  - a loop trace's NOP at the head of its loop body (asm_interrupt_check) becomes
+ *    `jmp` the loop snapshot's exit stub: every iteration crosses it, and there the
+ *    snapshot is exact (the loop head's PHI spills and shuffles have run) -- the
+ *    exit LuaJIT's own GC check takes at that spot. (Not the back-edge: there a PHI
+ *    spilled at the loop head is one iteration stale, and an inverted loop's jump
+ *    back is a guard whose exit resumes after a `for` loop.);
+ *  - a tail jmp to another trace (a side trace linking back to its root, tail
+ *    recursion) is pointed at the trampoline behind it (asm_tail_fixup), which
+ *    enters the interpreter at the linked trace's start pc, the stack already
+ *    synced -- exactly a link to the interpreter.
+ * A signal's saved RIP is always an instruction boundary and each patch replaces
+ * one whole 5-byte instruction, so there is no mid-instruction resume hazard.
+ *
+ * Patching only the running trace is not enough: a cycle can run root entry ->
+ * failing guard -> side trace -> root entry ... and never reach the root's loop
+ * (the signal lands while the root runs, whose loop is never entered; or while the
+ * side trace runs, which has no loop). So every jump that
+ * can close a cycle through the running trace is patched: all traces of its
+ * root's tree (side exits only go forward into the same tree) and, transitively,
+ * the trees their tail jmps link to. Whatever path the code takes, the next
+ * trace-to-trace transition or back-edge returns to the interpreter.
+ *
+ * Every patch is undone the instant the interpreter is reached: in lj_trace_exit
+ * (a side exit) or in the VM hook (the trampoline path skips lj_trace_exit). */
+#define CURSE_PATCH_MAX 1024
+static TraceNo1 curse_patched[CURSE_PATCH_MAX];  /* traces holding a patch */
+static volatile sig_atomic_t curse_patch_busy;
+
+/* Make [p, p+5) writable (and keep it executable). LuaJIT re-protects its whole
+ * mcode area read+exec whenever it commits a new trace. */
+static int curse_mcode_rwx(MCode *p)
+{
+  intptr_t pg = (intptr_t)sysconf(_SC_PAGESIZE);
+  intptr_t a = ((intptr_t)p) & ~(pg-1);
+  intptr_t b = (((intptr_t)p + 5 + pg-1) & ~(pg-1));
+  return mprotect((void *)a, (size_t)(b-a), PROT_READ|PROT_WRITE|PROT_EXEC);
+}
+
+void curse_sig_unpatch_one(GCtrace *T)
+{
+  if (!T->cursepatched) return;
+  T->cursepatched = 0;
+  if (curse_mcode_rwx(T->loopback)) return;
+  memcpy(T->loopback, T->cursesave, 5);
+}
+
+/* Put every patched jmp back. */
+void curse_sig_unpatch_all(void)
+{
+  lua_State *L = curse_globalL();
+  jit_State *J;
+  int i, n;
+  if (!curse_npatched || !L) return;
+  curse_patch_busy = 1;
+  J = G2J(G(L));
+  n = curse_npatched;
+  for (i = 0; i < n; i++) {
+    TraceNo t = curse_patched[i];
+    GCtrace *T = (t < J->sizetrace) ? (GCtrace *)gcref(J->trace[t]) : NULL;
+    if (T) curse_sig_unpatch_one(T);
+  }
+  curse_npatched = 0;
+  curse_patch_busy = 0;
+}
+
+static void curse_patch_one(GCtrace *T)
+{
+  MCode *bk = T->loopback;
+  if (!bk || T->cursepatched || curse_npatched >= CURSE_PATCH_MAX) return;
+  if (curse_mcode_rwx(bk)) return;
+  memcpy(T->cursesave, bk, 5);  /* Save what we clobber. */
+  T->cursepatched = 1;
+  curse_patched[curse_npatched++] = T->traceno;
+  bk[0] = 0xe9;  /* jmp rel32 -> exit stub / trampoline */
+  *(int32_t *)(bk+1) = (int32_t)(T->loopexit - (bk+5));
+  /* x86: sigreturn (iret) serializes, so the trace re-fetches the patched bytes. */
+}
+
+static GCtrace *curse_tref(jit_State *J, TraceNo t)
+{
+  return (t > 0 && t < J->sizetrace) ? (GCtrace *)gcref(J->trace[t]) : NULL;
