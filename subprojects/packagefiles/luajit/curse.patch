 /* Check GC threshold and do one or more GC steps. */
+/* curse: at the head of a loop's body, exit the trace when a VM hook is pending
+ * (g->hookmask != 0) so an async signal's scheduled hook can interrupt a
+ * JIT-compiled loop. Emits: movzx tmp, byte [g->hookmask]; test tmp,tmp;
+ * jne exitstub(loopsnapno) — a state-restoring side-exit to the interpreter.
+ * (Assumes asm_snap_prep() already done, like asm_gc_check.) */
+static void asm_interrupt_check(ASMState *as)
+{
+#ifdef CURSE_SIG_DESTRUCTIVE
+  /* Destructive-edit variant: no per-iteration check, but a 5-byte NOP right here,
+   * where the check would be, that curse_sig_patch_trace() overwrites with
+   * `jmp exitstub(loopsnapno)` on a signal (lj_trace_exit or the VM hook puts the
+   * NOP back). This is the one place in the loop where the loop snapshot is exact:
+   * every pass through the loop crosses it, and the loop head's code before it (PHI
+   * spill stores, register shuffles, the GC check) has run — the same spot the GC
+   * check's own exit to that snapshot uses. The loop's back-edge is NOT such a
+   * place: there, a PHI value spilled at the loop head still holds the previous
+   * iteration's value, and an inverted loop's guard exit resumes after a `for`
+   * loop — both exits corrupted state. One 5-byte instruction: a signal's saved
+   * RIP can't be inside it, so the rewrite is safe. */
+  static const MCode nop5[5] = { 0x0f, 0x1f, 0x44, 0x00, 0x00 };
+  as->mcp -= 5;
+  memcpy(as->mcp, nop5, 5);
+  as->T->loopback = as->mcp;
+  as->T->loopexit = exitstub_addr(as->J, as->loopsnapno);
+#else
+  Reg tmp = ra_scratch(as, RSET_GPR);
+  asm_guardcc(as, CC_NE);
+  emit_rr(as, XO_TEST, tmp, tmp);
+  emit_opgl(as, XO_MOVZXb, tmp, hookmask);
+#endif
+}
+
