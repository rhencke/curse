+{
+  lua_State *L = curse_globalL();
+  global_State *g;
+  jit_State *J;
+  GCtrace *T;
+  int32_t vs;
+  if (!L || curse_patch_busy) return;
+  g = G(L);
+  vs = (int32_t)g->vmstate;
+  if (vs <= 0) return;               /* Not currently executing a trace. */
+  J = G2J(g);
+  T = curse_tref(J, (TraceNo)vs);
