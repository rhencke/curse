+/* The trace whose loop the running code reaches next: this one, or — a side trace,
+ * or one without a loop — the trace it links to, or its root. */
+static GCtrace *curse_sig_looptrace(jit_State *J, GCtrace *T)
+{
+  GCtrace *U;
+  if (T->loopback) return T;
+  if (T->link && T->link < J->sizetrace && (U = traceref(J, T->link)) && U->loopback)
+    return U;
+  if (T->root && T->root < J->sizetrace && (U = traceref(J, T->root)) && U->loopback)
+    return U;
+  return NULL;
+}
+
+void curse_sig_patch_trace(void)
+{
+  lua_State *L = curse_globalL();
+  global_State *g;
+  jit_State *J;
+  GCtrace *T;
+  MCode *bk;
+  int32_t vs;
+  int kind, len;
+  intptr_t pg, a, b;
+  if (!L) return;
+  g = G(L);
+  vs = (int32_t)g->vmstate;
+  if (vs <= 0) return;               /* Not currently executing a trace. */
+  J = G2J(g);
+  if ((MSize)vs >= J->sizetrace) return;
+  T = traceref(J, (TraceNo)vs);
+  if (!T || !(T = curse_sig_looptrace(J, T))) return;  /* No patchable loop back-edge. */
+  bk = T->loopback;
+  kind = T->loopkind;
+  if (kind > 4) return;
+  len = curse_loop_len[kind];
