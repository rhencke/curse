     as->realign = NULL;  /* Stop another retry. */
+#ifdef CURSE_SIG_DESTRUCTIVE
+    as->T->loopback = NULL;  /* curse: loopinv realign is skipped (see below). */
+#endif
     lj_assertA(((intptr_t)target & 15) == 0, "loop realign failed");
     if (as->loopinv) {  /* Inverted loop branch? */
       p -= 5;
@@ -2871,6 +2897,13 @@ static void asm_loop_fixup(ASMState *as)
       lj_assertA(target - p >= -128, "loop realign failed");
       p[-1] = (MCode)(int8_t)(target - p);  /* Patch short jmp. */
       p[-2] = XI_JMPs;
+#ifdef CURSE_SIG_DESTRUCTIVE
+      /* curse: the back-edge is a 2-byte short jmp at mctop-2 (the loop's final
+       * safepoint). We can't fit a 5-byte jmp there, so on a signal we overwrite
+       * 5 bytes starting here, spilling 3 bytes into the reserved buffer past the
+       * trace end (asm_tail_start reserves it). Record the back-edge start. */
+      as->T->loopback = p-2;
+#endif
     }
   } else {
     MCode *newloop;
@@ -2880,12 +2913,20 @@ static void asm_loop_fixup(ASMState *as)
       p -= 5;
       newloop = target+4;
       *(int32_t *)(p-4) = (int32_t)(target - p);  /* Patch jcc. */
+#ifdef CURSE_SIG_DESTRUCTIVE
+      as->T->loopback = NULL;  /* curse: inverted-branch back-edge — skip (rare). */
+#endif
       if (as->loopinv == 2) {
 	*(int32_t *)(p-10) = (int32_t)(target - p + 6);  /* Patch opt. jp. */
 	newloop = target+8;
       }
     } else {  /* Otherwise just patch jmp. */
       *(int32_t *)(p-4) = (int32_t)(target - p);
+#ifdef CURSE_SIG_DESTRUCTIVE
+      /* curse: back-edge is a 5-byte E9 rel32 at mctop-5 (the loop's final
+       * safepoint) — already 5 bytes wide, so overwriting it needs no buffer. */
+      as->T->loopback = p-5;
+#endif
       newloop = target+3;
     }
