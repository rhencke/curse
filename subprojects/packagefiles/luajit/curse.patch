+  if (curse_patched_back) curse_sig_unpatch();  /* A stale patch (its trace never ran again). */
+  pg = (intptr_t)sysconf(_SC_PAGESIZE);
+  a = ((intptr_t)bk) & ~(pg-1);
+  b = (((intptr_t)bk + len + pg-1) & ~(pg-1));
+  if (mprotect((void *)a, (size_t)(b-a), PROT_READ|PROT_WRITE|PROT_EXEC)) return;
+  memcpy(curse_patched_orig, bk, len);             /* Save the bytes we rewrite. */
+  curse_patched_len = len;
+  curse_patched_back = bk;
+  switch (kind) {
+  case 0:  /* jmp rel32 -> loop exit stub. */
+    bk[0] = 0xe9;
+    *(int32_t *)(bk+1) = (int32_t)(T->loopexit - (bk+5));
+    break;
+  case 1:  /* jcc rel32 (ending at bk+4) -> loop exit stub */
+    *(int32_t *)bk = (int32_t)(T->loopexit - (bk+4));
+    break;
+  case 2:  /* jp rel32 (ending at bk+4), then jcc rel32 (ending at bk+10) */
+    *(int32_t *)bk = (int32_t)(T->loopexit - (bk+4));
+    *(int32_t *)(bk+6) = (int32_t)(T->loopexit - (bk+10));
+    break;
+  case 3:  /* jcc rel8 -> the jmp after it; the jmp's rel32 -> the guard's exit stub */
+    bk[0] = 0;
+    *(int32_t *)(bk+2) = (int32_t)(T->loopgexit - (bk+6));
+    break;
+  default:  /* jp rel8 and jcc rel8 -> that jmp; the jmp -> the guard's exit stub */
+    bk[0] = 2; bk[2] = 0;
+    *(int32_t *)(bk+4) = (int32_t)(T->loopgexit - (bk+8));
+    break;
+  }
+  /* x86: sigreturn (iret) serializes, so the trace re-fetches the patched bytes. */
