--- a/src/lj_asm_x86.h
+++ b/src/lj_asm_x86.h
@@ -2819,6 +2819,29 @@ static void asm_stack_restore(ASMState *as, SnapShot *snap)
 /* -- GC handling --------------------------------------------------------- */
 
 /* Check GC threshold and do one or more GC steps. */
+/* curse: at a loop back-edge, exit the trace when a VM hook is pending
+ * (g->hookmask != 0) so an async signal's scheduled hook can interrupt a
+ * JIT-compiled loop. Emits: movzx tmp, byte [g->hookmask]; test tmp,tmp;
+ * jne exitstub(loopsnapno) — a state-restoring side-exit to the interpreter.
+ * (Assumes asm_snap_prep() already done, like asm_gc_check.) */
+static void asm_interrupt_check(ASMState *as)
+{
+#ifdef CURSE_SIG_DESTRUCTIVE
+  /* Destructive-edit variant (no NOP, no per-iteration check — the trace is
+   * emitted exactly as LuaJIT would). We only record the loop snapshot's exit
+   * stub here; asm_loop_fixup records the address of the back-edge rel32 once it
+   * is emitted. On a signal that arrives while this trace runs,
+   * curse_sig_patch_trace() destructively repoints the back-edge jump at the exit
+   * stub, and lj_trace_exit restores the original target the instant we exit. */
+  as->T->loopexit = exitstub_addr(as->J, as->loopsnapno);
+#else
+  Reg tmp = ra_scratch(as, RSET_GPR);
+  asm_guardcc(as, CC_NE);
+  emit_rr(as, XO_TEST, tmp, tmp);
+  emit_opgl(as, XO_MOVZXb, tmp, hookmask);
+#endif
+}
+
