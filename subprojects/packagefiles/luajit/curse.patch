+#include <unistd.h>
+extern lua_State *curse_globalL(void);
+static MCode *curse_patched_back;   /* Addr of the patched back-edge (or NULL). */
+static MCode curse_patched_orig[12]; /* Its original bytes, to restore on exit. */
+static int curse_patched_len;        /* (how many) */
+
+/* curse: called from the async signal handler when a signal arrives while a JIT
+ * trace is running (LuaJIT hooks don't fire inside a trace). No NOP, no reserved
+ * slot: it destructively repoints the running loop's back-edge — an existing,
+ * necessary instruction — so the next pass through it is a clean, state-restoring
+ * side-exit to the interpreter (where the scheduled VM hook then runs the trap). A
+ * signal's saved RIP is always an instruction boundary and never lands inside the
+ * bytes rewritten, so there is no mid-instruction resume hazard. lj_trace_exit
+ * restores the original bytes the instant the exit fires. The back-edge kinds
+ * (T->loopkind, set by asm_loop_fixup):
+ *   0  `jmp loop` (rel32, or rel8 with 3 spare bytes after it): becomes `jmp rel32`
+ *      to the loop snapshot's exit stub — the machine state at the back-edge IS the
+ *      loop snapshot, so exiting there is exact.
+ *   1-4  an inverted loop: the loop's last guard jumps back (`[jp] jcc loop`, taken
+ *      at the same machine state as a `jmp loop`) and falls through to `jmp` its own
+ *      exit stub. 1, 2 (with the jp): rel32 displacements, pointed at the loop
+ *      snapshot's exit stub as for 0. 3, 4 (with the jp): rel8, which can't reach it:
+ *      they are pointed at the fall-through jmp, and that jmp at the guard's exit
+ *      stub (it may have been repointed at a side trace), so the trace leaves through
+ *      the guard's exit whichever way the guard goes — its snapshot is the state
+ *      there either way, and the interpreter re-runs the guarded instruction. */
+static const uint8_t curse_loop_len[5] = { 5, 4, 10, 6, 8 };
+
+/* Put the patched back-edge's bytes back. The page is made writable again first:
+ * LuaJIT re-protects its whole mcode area read+exec whenever it commits a new trace
+ * (a side trace compiled while the patch was armed), and the write would fault. */
+static void curse_sig_unpatch(void)
+{
+  MCode *bk = curse_patched_back;
+  intptr_t pg = (intptr_t)sysconf(_SC_PAGESIZE);
+  intptr_t a = ((intptr_t)bk) & ~(pg-1);
+  intptr_t b = (((intptr_t)bk + curse_patched_len + pg-1) & ~(pg-1));
+  curse_patched_back = NULL;
+  if (mprotect((void *)a, (size_t)(b-a), PROT_READ|PROT_WRITE|PROT_EXEC)) return;
+  memcpy(bk, curse_patched_orig, curse_patched_len);
