 {
@@ -2971,6 +3009,39 @@ static void asm_tail_fixup(ASMState *as, TraceNo lnk)
     *mcp++ = XI_GROUP5; *mcp++ = XM_OFS0 + (XOg_JMP<<3) + RID_EBP; mcp += 4;
     *((int32_t *)(mcp-4)) = (int32_t)(as->J->exitstubgroup[0] - 16 - mcp);
   }
+#if defined(CURSE_SIG_DESTRUCTIVE) && LJ_GC64
+  if (lnk) {
+    /* curse: a trace whose tail jumps to a trace (a side trace linking back to
+     * its root, tail recursion) can form a cycle that never reaches a loop
+     * back-edge -- root entry, failing guard, side trace, root entry ... -- so a
+     * signal patching only back-edges would never be delivered. Make the link
+     * jmp (5 bytes, E9 rel32) patchable too: behind it (unreachable until
+     * patched) sits a trampoline doing exactly what a link to the interpreter
+     * does (asm_tail_link has already synced every slot to the stack and set
+     * BASE; DISPATCH is callee-saved in GC64 mode):
+     *   mov rbx, pc; mov eax, MULTRES; jmp ->vm_exit_interp
+     * curse_sig_patch_trace() repoints the link jmp here, so the next pass
+     * resumes the interpreter at the linked trace's start pc, where the
+     * scheduled VM hook runs the trap (and removes the patch). */
+    MCode *jmpins = mcp - 5;
+    as->T->loopback = jmpins;
+    as->T->loopexit = mcp;
+    *mcp++ = 0x48; *mcp++ = 0xb8 + RID_LPC;  /* mov rbx, imm64 */
+    *(uint64_t *)mcp = (uint64_t)(uintptr_t)as->curse_pc; mcp += 8;
+    *mcp++ = 0xb8 + RID_RET;  /* mov eax, imm32 */
+    *(int32_t *)mcp = as->curse_mres; mcp += 4;
+    target = (MCode *)(void *)lj_vm_exit_interp;
+    if (jmprel_ok(mcp + 5, target)) {
+      *mcp++ = XI_JMP; mcp += 4;
+      *(int32_t *)(mcp-4) = jmprel(as->J, mcp, target);
+    } else {
+      *mcp++ = XI_GROUP5; *mcp++ = XM_OFS0 + (XOg_JMP<<3) + RID_EBP; mcp += 4;
