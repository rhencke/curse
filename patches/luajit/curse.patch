--- a/src/lj_clib.c
+++ b/src/lj_clib.c
@@ -137,9 +137,13 @@ static void clib_unloadlib(CLibrary *cl)
     dlclose(cl->handle);
 }
 
+extern void *curse_static_sym(const char *name);  /* curse: static libc symbol table */
 static void *clib_getsym(CLibrary *cl, const char *name)
 {
   void *p = dlsym(cl->handle, name);
+  /* In a fully-static binary glibc's dlsym is inoperative; fall back to curse's
+  ** link-time symbol table so ffi.C still resolves libc functions. */
+  if (!p) p = curse_static_sym(name);
   return p;
 }
 
