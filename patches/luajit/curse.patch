+/* curse: an OPTIONALLY-embedded precompiled module bundle (generated by
+ * lua/build.lua -> curse_bundle.c and linked into the self-contained static
+ * binary). Weak symbols, so the frontend also links WITHOUT it (dev builds load
+ * dist/curse.bc from disk instead). Running the chunk registers every curse
+ * module into package.preload, so require() resolves them from memory with no
+ * file open and no source parse — the whole point of the bundle, now with the
+ * file I/O removed too. */
+extern const unsigned char curse_bundle_bc[] __attribute__((weak));
+extern const unsigned int curse_bundle_bc_len __attribute__((weak));
+static void curse_load_bundle(lua_State *L)
+{
+  if (&curse_bundle_bc_len == 0) return;  /* not embedded in this binary */
+  if (luaL_loadbuffer(L, (const char *)curse_bundle_bc, curse_bundle_bc_len,
+                      "=curse.bundle") == 0)
+    lua_pcall(L, 0, 0, 0);  /* registers package.preload; errors are non-fatal */
+  else
+    lua_pop(L, 1);
+}
+
 static int pmain(lua_State *L)
 {
   struct Smain *s = &smain;
@@ -532,6 +554,34 @@ static int pmain(lua_State *L)
   globalL = L;
   LUAJIT_VERSION_SYM();  /* Linker-enforced version check. */
 
+  /* curse: run as a SHELL when invoked under a shell name (sh/bash/dash/ash/rbash/
+   * curse, or a login '-name') AND the module bundle is embedded. Route the whole
+   * argv to the bundled sh CLI (lua/run.lua) instead of LuaJIT's own option parser,
+   * so the self-contained static binary is a drop-in /bin/sh (`-c CODE`, `script
+   * args`, `-i`, shell options). The dynamic dev binary has no embedded bundle
+   * (curse_bundle_bc is a weak, undefined symbol there), so it never takes this path
+   * and stays a normal luajit. run.lua reads the global `arg` and os.exit()s. */
+  if (&curse_bundle_bc_len != 0 && s->argc >= 1 && argv[0]) {
+    const char *b = strrchr(argv[0], '/'); b = b ? b + 1 : argv[0];
+    if (*b == '-') b++;  /* login shell: -bash, -sh */
+    if (!strcmp(b, "sh") || !strcmp(b, "bash") || !strcmp(b, "dash") ||
+        !strcmp(b, "ash") || !strcmp(b, "rbash")) {  /* busybox-style: behavior by argv[0].
+        NOT "curse" itself — that stays luajit for dev/build/bytecode; deploy symlinks sh->curse. */
+      int i;
+      lua_gc(L, LUA_GCSTOP, 0);
+      luaL_openlibs(L);
+      curse_load_bundle(L);
+      lua_gc(L, LUA_GCRESTART, -1);
+      lua_createtable(L, s->argc, 1);  /* arg[0]=argv[0], arg[1..]=the shell args */
+      for (i = 0; i < s->argc; i++) { lua_pushstring(L, argv[i]); lua_rawseti(L, -2, i); }
+      lua_setglobal(L, "arg");
+      lua_getglobal(L, "require");
+      lua_pushliteral(L, "run");
+      s->status = lua_pcall(L, 1, 0, 0);  /* run.lua os.exit()s; returns only on error */
+      return 0;
+    }
+  }
+
   argn = collectargs(argv, &flags);
